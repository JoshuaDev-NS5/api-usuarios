# Copia este archivo como .env y ajusta los valores

# Clave secreta para firmar los JWT (¡cámbiala en producción!)
# Genera una con: openssl rand -hex 32
SECRET_KEY=cambia_esta_clave_secreta_en_produccion_usa_openssl_rand

# Duración del access token en minutos (default: 60)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Duración del refresh token en días (default: 7)
REFRESH_TOKEN_EXPIRE_DAYS=7

# Base de datos (SQLite por defecto, cambia a PostgreSQL en producción)
# SQLite:     sqlite:///./usuarios.db
# PostgreSQL: postgresql://user:password@localhost:5432/dbname
DATABASE_URL=sqlite:///./usuarios.db
